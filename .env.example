# Email Configuration
EMAILING_MODE=app_password # 'app_password' or 'smtp'

# For 'app_password' mode (e.g. Gmail)
GMAIL_USER=example@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# For 'smtp' mode
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_SECURE=false

# Common
ATHENAS_EMAIL=contact@athenas.com
